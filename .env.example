# --- PushPress login ---
# The client logs into PushPress on first use with these credentials, caches the
# JWT in SQLite, and auto-refreshes it whenever it is near expiry. You never
# touch tokens manually.
PUSHPRESS_EMAIL=
PUSHPRESS_PASSWORD=

# --- Timezone ---
# PushPress serialises class times with a misleading +00:00 suffix — the digits
# are actually the gym's local wall-clock. Set this to the gym's local zone.
TZ=Europe/Amsterdam

# --- Token cache ---
# Where the JWT is persisted. In Coolify, point this at a mounted volume.
DB_PATH=./data/pushpress.db

# --- MCP server (optional) ---
# Protect the streamable-HTTP MCP endpoint with a static bearer token.
# Leave empty to disable auth (local/stdio use only). Set it in Coolify.
MCP_TOKEN=
MCP_HOST=0.0.0.0
MCP_PORT=8000

LOG_LEVEL=INFO
